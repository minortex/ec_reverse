            'fb21f59c0d7059ba9b5fca213657e54ca3300485ba2b27b236fdaa73d7cf7a0f')

build() {
  cc $CPPFLAGS $CFLAGS -I"$srcdir" \
    -o "$srcdir/ec-flash" \
    "$srcdir/ec_flash.c" \
    "$srcdir/ec_io.c" \
    "$srcdir/follow.c" \
    "$srcdir/flash_read.c" \
    "$srcdir/flash_write.c" \
    $LDFLAGS
}

check() {
  "$srcdir/ec-flash" --help >/dev/null
  sh -n "$srcdir/ec-flash-system-shutdown"
}

package() {
  install -Dm755 "$srcdir/ec-flash" "$pkgdir/usr/bin/ec-flash"
  install -Dm755 "$srcdir/ec-flash-system-shutdown" \
    "$pkgdir/usr/lib/systemd/system-shutdown/ec-flash-reset"
}
